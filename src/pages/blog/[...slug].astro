---
// @ts-nocheck
import PageLayout from '../../layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { getCollection, render } from 'astro:content';
import BackToTop from '../../components/BackToTop.astro';

export async function getStaticPaths() {
  const posts = await getCollection('post');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.[^.]+$/, '') },
  }));
}

const { slug } = Astro.params;
const posts = await getCollection('post');
const post = posts.find((p) => p.id.replace(/\.[^.]+$/, '') === slug);

if (!post) {
  return new Response(null, { status: 404 });
}

const { data, body } = post;
const { Content, headings } = await render(post);

const title = data.title;
const subtitle = data.subtitle || '';
const publishDate = data.publishDate || null;
const tags = Array.isArray(data.tags) ? data.tags : [];

// 字数统计：中文字符 + 英文单词（基于正文纯文本）
const rawBody = body || '';
const cleanText = rawBody.replace(/<[^>]+>/g, '');
const charCount = (cleanText.match(/[\u4e00-\u9fa5]/g) || []).length;
const wordCount = (cleanText.match(/[a-zA-Z]+/g) || []).length;
const totalWords = charCount + wordCount;

// 预计阅读时间：250 字/分钟；小于 1 分钟显示“不到 1 分钟”
const minutes = totalWords / 250;
let readTimeText = '';
if (minutes < 1) {
  readTimeText = '不到 1 分钟';
} else {
  readTimeText = `约 ${Math.ceil(minutes)} 分钟`;
}

// 文章目录：仅 h2 / h3，数量 ≥ 2 才显示
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = tocHeadings.length >= 2;

const metadata = { title };
---

<PageLayout metadata={metadata}>
  <main class="max-w-6xl mx-auto px-4 py-12">
    <article class="mb-6" data-pagefind-body>
      <a href="/blog" class="inline-flex items-center gap-1 text-sm text-muted hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <Icon name="tabler:chevron-left" class="w-4 h-4" />
        返回博客列表
      </a>
      <h1 class="text-3xl font-bold mt-4" data-pagefind-meta="title">{title}</h1>
      {subtitle && (
        <p class="text-lg text-muted mt-2">{subtitle}</p>
      )}
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted mt-2">
        {publishDate && (
          <time data-pagefind-ignore>
            {publishDate.toLocaleDateString('zh-CN', {
              year: 'numeric', month: 'long', day: 'numeric'
            })}
          </time>
        )}
        <span aria-hidden="true" data-pagefind-ignore>·</span>
        <span data-pagefind-ignore>{totalWords} 字 · {readTimeText}</span>
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5" data-pagefind-filter="tag">
            {tags.map((tag) => (
              <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-primary/10 text-primary dark:bg-primary/20">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </article>

    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-12">
      <!-- 正文 -->
      <div class="min-w-0 prose prose-lg dark:prose-invert max-w-none">
        <Content />
      </div>

      <!-- 右侧固定目录 -->
      {showToc && (
        <aside class="hidden lg:block">
          <nav class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted mb-3">目录</p>
            <ol class="text-sm space-y-1 border-l border-gray-200 dark:border-slate-700">
              {tocHeadings.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    data-toc-link
                    class={`
                      block py-1 pr-3 border-l-2 -ml-px transition-colors
                      ${h.depth === 3 ? 'pl-8' : 'pl-4'}
                      border-transparent text-muted hover:text-primary
                    `}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
    </div>
  </main>
  <BackToTop />
</PageLayout>

<script>
  const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
  if (tocLinks.length) {
    const byId = new Map();
    tocLinks.forEach((link) => {
      const id = link.getAttribute('href').slice(1);
      const el = document.getElementById(id);
      if (el) byId.set(el, link);
    });

    // 点击平滑滚动
    tocLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const id = link.getAttribute('href').slice(1);
        const el = document.getElementById(id);
        if (el) {
          e.preventDefault();
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${id}`);
        }
      });
    });

    // 滚动高亮当前标题
    if ('IntersectionObserver' in window && byId.size) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              byId.forEach((link, el) => {
                if (el === entry.target) {
                  link.classList.add('active');
                } else {
                  link.classList.remove('active');
                }
              });
            }
          });
        },
        { rootMargin: '0px 0px -70% 0px', threshold: 0 }
      );
      byId.forEach((_, el) => observer.observe(el));
    }
  }
</script>

<style>
  [data-toc-link].active {
    color: rgb(var(--aw-color-primary));
    border-color: rgb(var(--aw-color-primary));
    font-weight: 500;
  }
</style>
