---
// @ts-nocheck
import PageLayout from '../../layouts/PageLayout.astro';
import { fetchPosts } from '../../utils/blog';

// 使用官方 getCollection('post') 接口（经 utils/blog 归一化），已按 publishDate 降序
const allPosts = await fetchPosts();

// 分页参数（第 1 页即 /blog，其余页在 /blog/page/[page]）
const postsPerPage = 6;
const currentPage = 1;
const totalPages = Math.ceil(allPosts.length / postsPerPage);
const start = (currentPage - 1) * postsPerPage;
const paginatedPosts = allPosts.slice(start, start + postsPerPage);

const metadata = { title: '博客' };

// 供客户端搜索脚本使用的可序列化文章数据（slug -> 字段）
const postList = allPosts.map((post) => ({
  slug: post.slug,
  title: post.title || '未命名',
  subtitle: post.subtitle || '',
  date: post.publishDate
    ? post.publishDate.toLocaleDateString('zh-CN', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })
    : '日期未知',
  dateRaw: post.publishDate ? post.publishDate.toISOString() : '',
  description: post.excerpt || '',
  image: post.image || '/blog-placeholder.webp',
  tags: post.tags ? post.tags.map((t) => t.title).slice(0, 3) : [],
}));
---

<PageLayout metadata={metadata}>
  <main class="max-w-7xl mx-auto px-4 py-12">
    <!-- 搜索框（sticky 固定于导航栏下方，z-index 低于导航栏，避免遮挡） -->
    <div
      class="mb-6 sticky top-16 z-10 bg-white dark:bg-slate-900 py-3 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      <div class="max-w-md mx-auto">
        <div class="relative">
          <span
            class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-muted"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
          <input
            id="blog-search-input"
            type="search"
            placeholder="搜索文章…"
            autocomplete="off"
            class="w-full rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 py-2.5 pl-10 pr-4 text-sm placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
          />
        </div>
        <!-- 搜索范围筛选 -->
        <div id="search-scope" class="flex flex-wrap justify-center gap-1.5 mt-3">
          {['all', 'title', 'tag', 'body'].map((scope) => {
            const label = { all: '全部', title: '标题', tag: '标签', body: '正文' }[scope];
            return (
              <button
                type="button"
                data-search-scope={scope}
                class={`text-[11px] font-medium px-2.5 py-1 rounded-full border transition-colors ${
                  scope === 'all'
                    ? 'bg-primary/10 text-primary border-primary/40'
                    : 'bg-white dark:bg-slate-800 text-muted border-gray-200 dark:border-slate-700 hover:border-primary/50 hover:text-primary'
                }`}
              >
                {label}
              </button>
            );
          })}
        </div>
      </div>
    </div>

    <!-- 标题（淡入动画） -->
    <div
      class="mb-10 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      <h1 class="text-2xl md:text-3xl font-bold mb-2 tracking-tight">所有文章</h1>
      <p class="text-muted text-sm">技术实践、折腾记录与日常随笔的全部文章列表。</p>
    </div>

    <!-- 文章列表区域：默认分页列表与搜索结果在此交叉淡入切换，保持高度稳定 -->
    <div id="posts-area" class="relative min-h-[400px]">
      <!-- 默认文章卡片网格（搜索框为空时显示） -->
      <div id="default-posts" class="transition-all duration-200">
        {
          allPosts.length === 0 ? (
            <p class="text-center text-muted">还没有文章，敬请期待！</p>
          ) : (
            <>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
                {paginatedPosts.map((post, index) => {
                  const image = post.image || '/blog-placeholder.webp';
                  const tags = post.tags ? post.tags.slice(0, 3) : [];
                  const delayClass = `delay-${(index % 6) * 100}`;
                  return (
                    <a
                      href={`/blog/${post.slug}`}
                      class={`group block bg-white dark:bg-slate-800 rounded-lg overflow-hidden border border-gray-200 dark:border-slate-700 hover:border-gray-300 dark:hover:border-slate-600 hover:shadow-lg transition-all duration-300 ${delayClass}`}
                    >
                      <div class="aspect-video overflow-hidden bg-gray-100 dark:bg-slate-700">
                        <img
                          src={image}
                          alt={post.title || '文章封面'}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                          loading={index === 0 ? 'eager' : 'lazy'}
                          {...(index === 0 ? { fetchpriority: 'high' } : {})}
                          decoding="async"
                        />
                      </div>
                      <div class="p-6">
                        <h2 class="text-base font-semibold group-hover:text-primary transition-colors line-clamp-2 leading-snug">
                          {post.title}
                        </h2>
                        {post.subtitle && <p class="text-sm text-muted mt-1 line-clamp-2">{post.subtitle}</p>}
                        <p class="text-xs text-muted mt-2">
                          {post.publishDate.toLocaleDateString('zh-CN', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric',
                          })}
                        </p>
                        {tags.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 mt-2.5">
                            {tags.map((tag) => (
                              <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-primary/10 text-primary dark:bg-primary/20">
                                {tag.title}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </a>
                  );
                })}
              </div>

              {totalPages > 1 && (
                <div class="flex justify-center mt-8 gap-2 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
                  {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
                    <a
                      href={p === 1 ? '/blog' : `/blog/page/${p}`}
                      class={`
                    px-3.5 py-1.5 rounded-md text-sm transition border
                    ${
                      p === currentPage
                        ? 'bg-primary text-white border-primary cursor-default'
                        : 'bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 hover:border-primary hover:text-primary'
                    }
                  `}
                    >
                      {p}
                    </a>
                  ))}
                </div>
              )}
            </>
          )
        }
      </div>

      <!-- 搜索结果卡片网格（有搜索词时显示，覆盖在默认列表之上，交叉淡入） -->
      <div
        id="search-results"
        class="absolute inset-0 transition-all duration-200 opacity-0 invisible pointer-events-none overflow-y-auto"
      >
        <div id="search-results-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
        <p id="search-empty" class="text-center text-muted hidden">没有找到相关文章。</p>
      </div>
    </div>
  </main>
</PageLayout>

<!-- 客户端搜索逻辑：内联文章数据 + Pagefind API -->
<script type="application/json" id="blog-posts-data" set:html={JSON.stringify(postList)} />

<script>
  // 搜索初始化：在每次 ClientRouter 页面切换（astro:page-load）后重新执行，
  // 重新获取当前 DOM 节点，避免模块脚本只执行一次导致事件绑定到旧节点。
  const state = {
    input: null,
    scopeBtns: [],
    defaultPosts: null,
    resultsWrap: null,
    resultsGrid: null,
    emptyMsg: null,
    timer: null,
    scope: 'all',
    bound: false,
  };

  function initSearch() {
    const input = document.getElementById('blog-search-input');
    // 若页面尚未渲染完成（如首次导航前脚本已执行），等到 DOM 就绪
    if (!input) return;

    // 每次导航都重新获取节点（ClientRouter 会替换 DOM）
    state.input = input;
    state.defaultPosts = document.getElementById('default-posts');
    state.resultsWrap = document.getElementById('search-results');
    state.resultsGrid = document.getElementById('search-results-grid');
    state.emptyMsg = document.getElementById('search-empty');
    state.scopeBtns = Array.from(document.querySelectorAll('[data-search-scope]'));

    // 防重复绑定：同一文档生命周期内只绑定一次
    if (state.bound) return;
    state.bound = true;

    input.addEventListener('input', () => {
      clearTimeout(state.timer);
      state.timer = setTimeout(runSearch, 250);
    });

    state.scopeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        state.scope = btn.dataset.searchScope;
        // 更新选中态
        state.scopeBtns.forEach((b) => {
          const active = b.dataset.searchScope === state.scope;
          b.className =
            'text-[11px] font-medium px-2.5 py-1 rounded-full border transition-colors ' +
            (active
              ? 'bg-primary/10 text-primary border-primary/40'
              : 'bg-white dark:bg-slate-800 text-muted border-gray-200 dark:border-slate-700 hover:border-primary/50 hover:text-primary');
        });
        // 有内容时立即按新范围重新搜索
        if (state.input.value.trim()) {
          clearTimeout(state.timer);
          state.timer = setTimeout(runSearch, 0);
        }
      });
    });
  }

  const postList = JSON.parse(document.getElementById('blog-posts-data').textContent);
  const bySlug = Object.fromEntries(postList.map((p) => [p.slug, p]));

  function formatDate(iso) {
    if (!iso) return '日期未知';
    try {
      return new Date(iso).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
    } catch {
      return '日期未知';
    }
  }

  function renderCard(post, index = 0) {
    const a = document.createElement('a');
    a.href = `/blog/${post.slug}`;
    a.className =
      'group block bg-white dark:bg-slate-800 rounded-lg overflow-hidden border border-gray-200 dark:border-slate-700 hover:border-gray-300 dark:hover:border-slate-600 hover:shadow-lg transition-all duration-300 animate-fade-in-up';
    a.style.animationDelay = `${index * 0.08}s`;

    const imgWrap = document.createElement('div');
    imgWrap.className = 'aspect-video overflow-hidden bg-gray-100 dark:bg-slate-700';
    const img = document.createElement('img');
    img.src = post.image || '/blog-placeholder.webp';
    img.alt = post.title || '文章封面';
    img.loading = index === 0 ? 'eager' : 'lazy';
    img.fetchPriority = index === 0 ? 'high' : 'auto';
    img.decoding = 'async';
    img.className = 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-300';
    imgWrap.appendChild(img);

    const body = document.createElement('div');
    body.className = 'p-6';

    const title = document.createElement('h2');
    title.className = 'text-base font-semibold group-hover:text-primary transition-colors line-clamp-2 leading-snug';
    title.textContent = post.title || '';
    body.appendChild(title);

    if (post.subtitle) {
      const subtitle = document.createElement('p');
      subtitle.className = 'text-sm text-muted mt-1 line-clamp-2';
      subtitle.textContent = post.subtitle;
      body.appendChild(subtitle);
    }

    const date = document.createElement('p');
    date.className = 'text-xs text-muted mt-2';
    date.textContent = formatDate(post.dateRaw);
    body.appendChild(date);

    if (post.description) {
      const desc = document.createElement('p');
      desc.className = 'text-muted mt-2 text-sm line-clamp-2';
      desc.textContent = post.description;
      body.appendChild(desc);
    }

    if (post.tags && post.tags.length) {
      const tagWrap = document.createElement('div');
      tagWrap.className = 'flex flex-wrap gap-1.5 mt-2.5';
      post.tags.forEach((tag) => {
        const s = document.createElement('span');
        s.className = 'text-[11px] font-medium px-2 py-0.5 rounded bg-primary/10 text-primary dark:bg-primary/20';
        s.textContent = tag;
        tagWrap.appendChild(s);
      });
      body.appendChild(tagWrap);
    }

    a.appendChild(imgWrap);
    a.appendChild(body);
    return a;
  }

  // 从 Pagefind 的 result.id（形如 /blog/my-slug/）解析 slug 并匹配本地数据
  function slugFromId(id) {
    const m = String(id || '').match(/\/blog\/([^/]+)\/?$/);
    return m ? m[1] : null;
  }

  // 视图切换：用 opacity/visibility 交叉淡入，避免 display:none 造成的闪烁与高度突变
  function showDefaultView() {
    state.defaultPosts.classList.remove('invisible', 'opacity-0', 'pointer-events-none');
    state.resultsWrap.classList.add('invisible', 'opacity-0', 'pointer-events-none');
  }

  function showResultsView() {
    state.defaultPosts.classList.add('invisible', 'opacity-0', 'pointer-events-none');
    state.resultsWrap.classList.remove('invisible', 'opacity-0', 'pointer-events-none');
  }

  // 数字/日期噪音兜底：查询清洗后只剩数字/日期特征，正文范围视为无意义
  function isNoiseQuery(q) {
    if (!q) return true;
    const cleaned = q.replace(/[\s，。、,.·年月日时分秒]+/g, '');
    if (/^\d+$/.test(cleaned)) return true; // 纯数字
    if (/^\d{4}$/.test(cleaned)) return true; // 年份
    return false;
  }

  // 本地字段匹配（标题/标签），返回命中的 post 数组
  function matchLocal(q, scope) {
    const lower = q.toLowerCase();
    return postList.filter((post) => {
      if (scope === 'title') {
        return (post.title + ' ' + post.subtitle).toLowerCase().includes(lower);
      }
      if (scope === 'tag') {
        return post.tags.some((t) => t.toLowerCase().includes(lower));
      }
      // scope === 'all'：标题/标签任一命中
      return (
        (post.title + ' ' + post.subtitle).toLowerCase().includes(lower) ||
        post.tags.some((t) => t.toLowerCase().includes(lower))
      );
    });
  }

  async function runSearch() {
    const query = state.input.value.trim();

    if (!query) {
      // 空查询：清空结果并恢复默认分页列表
      state.resultsGrid.textContent = '';
      state.emptyMsg.classList.add('hidden');
      showDefaultView();
      return;
    }

    const scope = state.scope;
    // 命中结果的 slug 集合（用 Set 去重，保持顺序）
    const slugSet = new Set();

    // 标题/标签/全部范围：先做本地匹配
    if (scope === 'title' || scope === 'tag' || scope === 'all') {
      matchLocal(query, scope).forEach((post) => slugSet.add(post.slug));
    }

    // 正文/全部范围：走 Pagefind；数字噪音查询直接跳过
    if (scope === 'body' || scope === 'all') {
      if (!isNoiseQuery(query)) {
        try {
          // 用变量承载 URL，避免 Vite 静态分析 import 字面量（该文件仅存在于构建产物 /pagefind/）
          const pagefindUrl = '/pagefind/pagefind.js';
          const pagefind = await import(/* @vite-ignore */ pagefindUrl);
          const search = await pagefind.search(query);
          const ids = search.results || [];
          const results = await Promise.all(
            ids.map((r) =>
              r
                .data()
                .then((d) => ({ id: d.url || r.id, title: d.meta?.title || '' }))
                .catch(() => null)
            )
          );
          for (const res of results) {
            const slug = slugFromId(res?.id);
            if (slug) slugSet.add(slug);
          }
        } catch (err) {
          console.error('Pagefind 搜索失败：', err);
        }
      }
    }

    // 渲染命中卡片（按 postList 顺序，保证一致性）
    const fragment = document.createDocumentFragment();
    let matched = 0;
    for (const post of postList) {
      if (slugSet.has(post.slug)) {
        fragment.appendChild(renderCard(post, matched));
        matched++;
      }
    }

    // 内容就绪后再切换到结果视图
    state.resultsGrid.textContent = '';
    state.emptyMsg.classList.add('hidden');
    if (matched === 0) {
      state.emptyMsg.classList.remove('hidden');
    }
    showResultsView();

    // 推迟到下一帧渲染，确保淡入动画正常触发、无白屏
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        state.resultsGrid.appendChild(fragment);
      });
    });
  }

  // 每次 ClientRouter 页面切换完成后重新初始化（首次加载也会触发）
  document.addEventListener('astro:page-load', initSearch);
</script>

<style is:global>
  .animate-fade-in-up {
    animation: fadeInUpCard 0.4s ease-out both;
  }

  @keyframes fadeInUpCard {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
