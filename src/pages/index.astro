---
import PageLayout from '../layouts/PageLayout.astro';
import { fetchPosts, findLatestPosts } from '../utils/blog';

// 使用官方 getCollection('post') 接口读取，返回已按 publishDate 降序排序的文章
const allPosts = await fetchPosts();
const recentPosts = (await findLatestPosts({ count: 3 })) || allPosts.slice(0, 3);

const metadata = { title: '主页' };
---

<PageLayout metadata={metadata}>
  <main class="max-w-6xl mx-auto px-4 py-12">
    <!-- 1. 个人介绍（淡入动画） -->
    <section
      class="text-center mb-12 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      <img
        src="/avatar.jpg"
        alt="我的头像"
        class="w-32 h-32 rounded-full mx-auto mb-4 object-cover border-4 border-gray-200 dark:border-slate-700"
      />
      <h1 class="text-3xl font-bold">二咪喵喵</h1>
      <p class="text-lg text-muted mt-2">In case I don't see you, good afternoon, good evening, and good night.</p>
    </section>

    <!-- 2. 网站介绍（淡入动画） -->
    <section
      class="prose prose-lg dark:prose-invert mx-auto mb-12 text-center intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      <p>一只懒猫记录生活点滴的笔记簿，分享一些有趣的事情，也许会有一些技术文章和实用工具。</p>
    </section>

    <!-- 3. 最近博客文章（淡入动画） -->
    <section
      class="mb-12 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      <h2 class="text-2xl font-semibold mb-6 text-center">最近的博客文章</h2>
      {
        recentPosts.length === 0 ? (
          <p class="text-center text-muted">还没有文章，敬请期待！</p>
        ) : (
          <>
            <div
              class="flex gap-4 -mx-4 px-4 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-thin lg:grid lg:grid-cols-3 lg:gap-6 lg:mx-0 lg:px-0 lg:overflow-visible lg:snap-none lg:pb-0"
              style="scroll-padding-left: 16px; scroll-padding-right: 16px;"
            >
              {recentPosts.map((post, index) => {
                const heroImage = post.image || '/blog-placeholder.jpg';
                const delayClass = index < 3 ? `delay-${(index + 1) * 100}` : '';
                return (
                  <a
                    href={`/blog/${post.slug}`}
                    class={`group block w-[280px] sm:w-[320px] lg:w-auto shrink-0 snap-start bg-white dark:bg-slate-800 rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300 ${delayClass}`}
                  >
                    <div class="aspect-video overflow-hidden bg-gray-100 dark:bg-slate-700">
                      <img
                        src={heroImage}
                        alt={post.title || '文章封面'}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                      />
                    </div>
                    <div class="p-5">
                      <h3 class="text-xl font-semibold group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                        {post.title}
                      </h3>
                      {post.publishDate && (
                        <p class="text-sm text-muted mt-1">
                          {post.publishDate.toLocaleDateString('zh-CN', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric',
                          })}
                        </p>
                      )}
                      {post.excerpt && <p class="text-muted mt-2 text-sm line-clamp-2">{post.excerpt}</p>}
                    </div>
                  </a>
                );
              })}
            </div>
            {recentPosts.length > 1 && (
              <p class="lg:hidden text-center text-sm text-muted mt-2 select-none">← 滑动浏览更多 →</p>
            )}
          </>
        )
      }
      <div class="text-center mt-8">
        <a href="/blog" class="text-blue-600 dark:text-blue-400 hover:underline">查看全部文章 →</a>
      </div>
    </section>
  </main>
</PageLayout>
