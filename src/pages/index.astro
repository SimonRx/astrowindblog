---
import PageLayout from '../layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { fetchPosts, findLatestPosts } from '../utils/blog';

// 使用官方 getCollection('post') 接口读取，返回已按 publishDate 降序排序的文章
const allPosts = await fetchPosts();
const recentPosts = (await findLatestPosts({ count: 3 })) || allPosts.slice(0, 3);

const metadata = { title: '主页' };
---

<PageLayout metadata={metadata}>
  <main class="max-w-6xl mx-auto px-4 py-12">
    <!-- Hero（Hey There 水印 + 欢迎标题 + 介绍） -->
    <section
      class="text-center mb-16 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      <p class="font-display text-[clamp(3.6rem,13vw,7rem)] leading-[0.95] font-bold text-[#d5d5d7] dark:text-white/40 select-none">
        Hey There
      </p>
      <p class="text-muted mt-4">👋 嘿，你来啦！</p>
      <h1 class="font-title text-[clamp(2.2rem,7vw,3.2rem)] font-extrabold leading-tight mt-4">
        欢迎来到<br class="sm:hidden"><span class="accent-underline">二咪的小站</span>
      </h1>
      <p class="mt-6 text-sm md:text-base leading-relaxed text-muted max-w-xl mx-auto">
        一只懒猫记录<span class="text-[#4a74ad] dark:text-[#5d84c0] font-semibold">生活点滴</span>的笔记簿，分享一些有趣的事情，
        也许会有一些<span class="text-[#4a74ad] dark:text-[#5d84c0] font-semibold">技术文章</span>和<span class="text-[#4a74ad] dark:text-[#5d84c0] font-semibold">实用工具</span>。
      </p>
    </section>

    <!-- 3. 最近博客文章（淡入动画） -->
    <section
      class="mb-12 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      <h2 class="font-title text-3xl font-extrabold mb-6 text-center transition-colors hover:text-[#4a74ad] dark:hover:text-[#5d84c0]">最近的博客文章</h2>
      {
        recentPosts.length === 0 ? (
          <p class="text-center text-muted">还没有文章，敬请期待！</p>
        ) : (
          <>
            <div
              class={`flex gap-4 -mx-4 px-4 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-thin ${
                recentPosts.length === 1 ? 'justify-center' : ''
              } lg:mx-0 lg:px-0 lg:overflow-visible lg:snap-none lg:pb-0 ${
                recentPosts.length < 3 ? 'lg:flex lg:flex-wrap lg:justify-center lg:gap-6' : 'lg:grid lg:grid-cols-3 lg:gap-6'
              }`}
              style="scroll-padding-left: 16px; scroll-padding-right: 16px;"
            >
              {recentPosts.map((post, index) => {
                const heroImage = post.image || '/blog-placeholder.webp';
                const delayClass = index < 3 ? `delay-${(index + 1) * 100}` : '';
                return (
                  <a
                    href={`/blog/${post.slug}`}
                    class={`group block w-[280px] sm:w-[320px] shrink-0 snap-start bg-white dark:bg-slate-800 rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300 ${
                      recentPosts.length < 3 ? 'lg:w-96' : 'lg:w-auto'
                    } ${delayClass}`}
                  >
                    <div class="aspect-video overflow-hidden bg-gray-100 dark:bg-slate-700">
                      <img
                        src={heroImage}
                        alt={post.title || '文章封面'}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        loading={index === 0 ? 'eager' : 'lazy'}
                        {...(index === 0 ? { fetchpriority: 'high' } : {})}
                        decoding="async"
                      />
                    </div>
                    <div class="p-5">
                      <h3 class="text-xl font-semibold group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                        {post.title}
                      </h3>
                      {post.publishDate && (
                        <p class="text-sm text-muted mt-1">
                          {post.publishDate.toLocaleDateString('zh-CN', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric',
                          })}
                        </p>
                      )}
                      {post.excerpt && <p class="text-muted mt-2 text-sm line-clamp-2">{post.excerpt}</p>}
                    </div>
                  </a>
                );
              })}
            </div>
            {recentPosts.length > 1 && (
              <p class="lg:hidden text-center text-sm text-muted mt-2 select-none">← 滑动浏览更多 →</p>
            )}
          </>
        )
      }
      <div class="text-center mt-8">
        <a href="/blog" class="btn font-title group inline-flex items-center gap-2">
          查看全部文章
          <Icon
            name="tabler:arrow-right"
            class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
          />
        </a>
      </div>
    </section>
  </main>
</PageLayout>

<style>
  /* 标题「二咪的小站」蓝色下划线高亮点缀 */
  .accent-underline {
    position: relative;
    padding: 0 4px;
  }
  .accent-underline::after {
    content: '';
    position: absolute;
    left: 4px;
    right: 4px;
    bottom: 4px;
    height: 12px;
    background: rgba(120, 165, 235, 0.35);
    border-radius: 8px;
    z-index: -1;
  }
</style>
