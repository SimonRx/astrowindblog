---
import PageLayout from '../../layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { tools } from '../../data/tools';

const metadata = { title: '工具箱' };
---

<PageLayout metadata={metadata}>
  <main class="max-w-6xl mx-auto px-4 py-12">
    <div
      class="text-center mb-12 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      <h1 class="text-3xl font-bold mb-3">工具箱</h1>
      <p class="text-muted">一些实用的纯前端小工具，全部在浏览器本地运行。</p>
    </div>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-3xl mx-auto intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      {
        tools.map((tool, index) => {
          const delayClass = `delay-${(index % 6) * 100}`;
          return (
            <a
              href={`/tools/${tool.slug}`}
              class={`group block bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 p-8 text-center shadow-md hover:shadow-xl transition-shadow duration-300 ${delayClass}`}
            >
              <div class="w-14 h-14 mx-auto rounded-lg bg-[#4a74ad]/10 dark:bg-[#8ab4f8]/15 flex items-center justify-center text-[#4a74ad] dark:text-[#8ab4f8] mb-4 group-hover:scale-110 transition-transform duration-300">
                <Icon name={tool.icon} class="w-8 h-8" />
              </div>
              <h2 class="text-xl font-semibold group-hover:text-[#4a74ad] dark:group-hover:text-[#8ab4f8] transition-colors">
                {tool.name}
              </h2>
              <div class="flex flex-wrap justify-center gap-2 mt-3">
                {tool.features.map((feature) => (
                  <span class="rounded-full border border-gray-200 dark:border-slate-600 px-3 py-1 text-xs text-muted">
                    {feature}
                  </span>
                ))}
              </div>
              <span class="inline-flex items-center gap-1 mt-4 rounded-full border border-[#4a74ad]/40 dark:border-[#8ab4f8]/50 px-4 py-1.5 text-sm font-medium text-[#4a74ad] dark:text-[#8ab4f8] group-hover:bg-[#4a74ad] dark:group-hover:bg-[#8ab4f8] group-hover:text-white transition-colors">
                打开 <Icon name="tabler:arrow-right" class="w-4 h-4" />
              </span>
            </a>
          );
        })
      }
    </div>
  </main>
</PageLayout>
