---
import "@pagefind/component-ui/css/pagefind-component-ui.css";
import { join } from "node:path/posix";

const bundlePath = join(import.meta.env.BASE_URL, "pagefind/");
---

<pagefind-config bundle-path={bundlePath}></pagefind-config>
<pagefind-searchbox class="searchbox"></pagefind-searchbox>
<script>
  import "@pagefind/component-ui";
</script>

<style>
  .searchbox {
    width: 100%;
    max-width: 28rem;
    margin-inline: auto;
  }
  :global(pagefind-searchbox) {
    --pagefind-ui-scale: 0.95;
    --pf-dropdown-z-index: 100;
    position: relative;
    z-index: 100;
  }
  :global(pagefind-searchbox .pf-searchbox-dropdown),
  :global(pagefind-searchbox .pf-searchbox-results) {
    position: relative;
    z-index: 100;
  }
</style>
